{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/admin-users.js": {
      "maxDuration": 15
    },
    "api/catalogo.js": {
      "maxDuration": 10
    },
    "api/pedido.js": {
      "maxDuration": 10
    },
    "api/otp-send.js": {
      "maxDuration": 15
    },
    "api/otp-verify.js": {
      "maxDuration": 10
    },
    "api/historial.js": {
      "maxDuration": 10
    },
    "api/cron-carrito-abandonado.js": {
      "maxDuration": 60
    },
    "api/cron-reservations.js": {
      "maxDuration": 30
    },
    "api/cron-ventas.js": {
      "maxDuration": 300
    },
    "api/cron-activacion.js": {
      "maxDuration": 60
    },
    "api/cron-health.js": {
      "maxDuration": 30
    },
    "api/cron-reposicion.js": {
      "maxDuration": 300
    },
    "api/cron-cobranzas.js": {
      "maxDuration": 300
    },
    "api/cron-reactivacion.js": {
      "maxDuration": 300
    },
    "api/cron-director.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [{
    "path": "/api/cron-trial",
    "schedule": "0 12 * * *"
  }, {
    "path": "/api/cron-carrito-abandonado",
    "schedule": "0 * * * *"
  }, {
    "path": "/api/cron-reservations",
    "schedule": "0 * * * *"
  }, {
    "path": "/api/cron-ventas",
    "schedule": "0 11 * * *"
  }, {
    "path": "/api/cron-activacion",
    "schedule": "0 13 * * *"
  }, {
    "path": "/api/cron-health",
    "schedule": "*/10 * * * *"
  }, {
    "path": "/api/cron-reposicion",
    "schedule": "0 14 * * *"
  }, {
    "path": "/api/cron-cobranzas",
    "schedule": "0 15 * * *"
  }, {
    "path": "/api/cron-reactivacion",
    "schedule": "0 16 * * *"
  }, {
    "path": "/api/cron-director",
    "schedule": "0 12 * * 1"
  }],
  "version": 2
}